# Copy to ".env" for docker compose and local tooling.
# Replace POSTGRES_PASSWORD before any shared or non-local use.

POSTGRES_USER=opsdesk
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=opsdesk
POSTGRES_PORT=5432

# Hostname for tools on your machine talking to the compose-published port:
POSTGRES_HOST=localhost

# Example connection string for an app on the host:
DATABASE_URL=postgresql://opsdesk:change_me_local_only@localhost:5432/opsdesk
